# Copy this file to .env and fill in your values.
# The .env file is gitignored — never commit real secrets.

# URL of the Express proxy server (used by the web build to avoid CORS).
# For local development: http://localhost:3001
# For production: https://your-deployed-api-server.example.com
# Leave empty on native (iOS/Android) — the app fetches directly.
EXPO_PUBLIC_API_URL=http://localhost:3001
