# Project-local npm config.
#
# legacy-peer-deps=true is required because:
#   • The project runs React 19.2 (the version Expo SDK 55 ships with).
#   • A handful of UI / icon libraries in the dependency tree still pin their
#     peer-dep range to "^16 || ^17 || ^18" without updating for React 19,
#     which is a peer range labelling problem, not an actual incompatibility.
#   • Without this flag, `npm install` fails with ERESOLVE on a fresh clone.
#
# When every transitive dep in the graph publishes React 19 in its peer range,
# this line can be removed.
legacy-peer-deps=true
