# ── DocuMind backend configuration ───────────────────────────────────────────
# The app talks to this server; the server holds the AI provider key so it
# never reaches the device.

# Your AI provider key (OpenAI / ChatGPT / kit.ai gateway key).
AI_API_KEY=sk-...

# Base URL of the OpenAI-compatible API. Leave blank for OpenAI itself.
# For your kit.ai gateway, point this at its OpenAI-compatible endpoint, e.g.:
#   AI_BASE_URL=https://api.kit.ai/v1
AI_BASE_URL=

# Chat / vision model used for OCR, classification and answers.
# Must support image input for scanning to work (e.g. gpt-4o, gpt-4o-mini).
AI_MODEL=gpt-4o

# Embedding model used for retrieval (RAG).
AI_EMBED_MODEL=text-embedding-3-small

# Port the server listens on.
PORT=3001
