# ── DocuMind backend configuration ───────────────────────────────────────────
# The app talks to this server; the server holds the AI provider key so it
# never reaches the device.

# Your AI provider key. For KIT ki-toolbox this is your OPENAI_API_KEY.
AI_API_KEY=sk-...

# Base URL of the OpenAI-compatible API.
# KIT ki-toolbox (Open WebUI):
AI_BASE_URL=https://ki-toolbox.scc.kit.edu/api/v1
# For plain OpenAI instead, leave AI_BASE_URL blank.

# Chat / vision model. azure.gpt-4.1 supports image input, so scanning works.
AI_MODEL=openai/azure.gpt-4.1

# Embedding model used for retrieval (RAG). If the gateway doesn't provide one,
# leave this blank — the server automatically falls back to keyword retrieval.
AI_EMBED_MODEL=

# Port the server listens on.
PORT=3001
