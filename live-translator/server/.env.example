# Port the server listens on
PORT=8787

# Shared secret the mobile app sends in the `x-app-token` header.
# Set the same value in the app settings (Setup → Server).
APP_TOKEN=change-me

# Anthropic API key (translation + language confirmation)
ANTHROPIC_API_KEY=
# Model used for translation. Default: claude-opus-5-5.
# For the lowest latency you can switch to claude-haiku-5-5.
TRANSLATION_MODEL=claude-opus-5-5

# Soniox API key (streaming speech-to-text, language ID, speaker diarization)
SONIOX_API_KEY=
SONIOX_MODEL=stt-rt-v3
