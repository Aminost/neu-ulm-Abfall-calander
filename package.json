{
  "name": "neu-ulm-muellkalender",
  "private": true,
  "version": "1.4.0",
  "main": "expo-router/entry",
  "scripts": {
    "postinstall": "patch-package",
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build:web": "expo export --platform web",
    "build:android": "eas build --platform android --non-interactive",
    "build:ios": "eas build --platform ios --non-interactive",
    "build:all": "eas build --platform all --non-interactive",
    "submit:android": "eas submit --platform android",
    "submit:ios": "eas submit --platform ios",
    "update": "eas update",
    "api": "tsx api/server.ts",
    "api:prod": "cross-env NODE_ENV=production tsx api/server.ts",
    "type-check": "tsc --noEmit",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@expo/metro-runtime": "^55.0.10",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@turf/turf": "^7.3.4",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "expo": "^55.0.19",
    "expo-constants": "^55.0.15",
    "expo-document-picker": "~55.0.13",
    "expo-file-system": "~55.0.17",
    "expo-font": "~55.0.6",
    "expo-linking": "^55.0.14",
    "expo-location": "~55.1.8",
    "expo-notifications": "^55.0.20",
    "expo-router": "^55.0.13",
    "expo-splash-screen": "^55.0.19",
    "expo-status-bar": "~55.0.5",
    "lucide-react-native": "^1.14.0",
    "nativewind": "^4.0.1",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "0.83.6",
    "react-native-calendars": "^1.1302.0",
    "react-native-gesture-handler": "~2.30.0",
    "react-native-reanimated": "4.2.1",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.23.0",
    "react-native-svg": "15.15.3",
    "react-native-web": "^0.21.0",
    "react-native-webview": "13.16.0",
    "react-native-worklets": "~0.7.4",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.1.1",
    "cross-env": "^10.1.0",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "patch-package": "^8.0.0",
    "tailwindcss": "^3.4.15",
    "tsx": "^4.21.0",
    "typescript": "~5.9.0"
