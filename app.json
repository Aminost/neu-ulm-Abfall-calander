{
  "expo": {
    "name": "Neu-Ulm Müllkalender",
    "slug": "neu-ulm-muellkalender",
    "version": "1.4.0",
    "orientation": "portrait",
    "icon": "assets/images/icon.png",
    "scheme": "muellkalender",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "assets/images/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#10b981"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "de.neuulm.muellkalender",
      "buildNumber": "4",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Wir verwenden deinen Standort, um deinen Abfuhrbezirk automatisch zu erkennen.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Wir verwenden deinen Standort, um deinen Abfuhrbezirk automatisch zu erkennen."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "assets/images/icon.png",
        "backgroundColor": "#10b981"
      },
      "package": "de.neuulm.muellkalender",
      "permissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "bundler": "metro",
      "favicon": "assets/images/icon.png",
      "output": "single",
      "name": "Neu-Ulm Müllkalender",
      "themeColor": "#10b981",
      "backgroundColor": "#f9fafb"
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "icon": "assets/images/icon.png",
          "color": "#10b981",
          "sounds": []
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Wir verwenden deinen Standort, um deinen Abfuhrbezirk automatisch zu erkennen."
        }
      ],
      [
        "expo-document-picker",
        {
          "iCloudContainerEnvironment": "Production"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "apiUrl": "",
      "eas": {
        "projectId": "643ce0a4-ae21-40f7-a142-51fedc88aa72"
      },
      "router": {}
    },
    "owner": "guedria"
  }
}
