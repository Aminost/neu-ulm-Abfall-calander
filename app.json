{
  "expo": {
    "name": "Neu-Ulm Abfallkalender",
    "slug": "neu-ulm-muellkalender",
    "version": "1.5.1",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "muellkalender",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "de.neuulm.muellkalender",
      "buildNumber": "6",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Wir verwenden deinen Standort, um deinen Abfuhrbezirk automatisch zu erkennen.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Wir verwenden deinen Standort, um deinen Abfuhrbezirk automatisch zu erkennen."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#059669"
      },
      "package": "de.neuulm.muellkalender",
      "permissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.POST_NOTIFICATIONS"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "com.google.android.gms.permission.AD_ID"
      ]
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/images/favicon.png",
      "output": "single",
      "name": "Neu-Ulm Abfallkalender",
      "themeColor": "#059669",
      "backgroundColor": "#f9fafb"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#059669"
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#059669",
          "sounds": []
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Wir verwenden deinen Standort, um deinen Abfuhrbezirk automatisch zu erkennen."
        }
      ],
      [
        "expo-document-picker",
        {
          "iCloudContainerEnvironment": "Production"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "apiUrl": "",
      "eas": {
        "projectId": "643ce0a4-ae21-40f7-a142-51fedc88aa72"
      },
      "router": {}
    },
    "owner": "guedria"
  }
}
